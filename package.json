{
	"name": "vaultforge",
	"version": "0.0.4",
	"description": "Bring Claude into your Obsidian vault: a local MCP server, an AI chat assistant, and Claude Skills management.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"sync": "node copy-to-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"claude",
		"mcp",
		"ai"
	],
	"author": "WalSplitter",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.14.2",
		"@typescript-eslint/eslint-plugin": "^7.13.0",
		"@typescript-eslint/parser": "^7.13.0",
		"esbuild": "^0.21.4",
		"obsidian": "latest",
		"tslib": "^2.6.3",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.226",
		"@anthropic-ai/sdk": "^0.116.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.4.3"
	}
}
